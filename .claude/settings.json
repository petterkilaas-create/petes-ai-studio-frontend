      "Bash(git worktree remove *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git reset --hard *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .*)"
    ]
  }
